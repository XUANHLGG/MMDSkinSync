+            Method loadStagePacks = facade.getClass().getMethod("loadStagePacks");
+            Object loaded = loadStagePacks.invoke(facade);
+            if (!(loaded instanceof List<?> packs)) {
+                return false;
             }
+
+            Method selectedPack = state.getClass().getDeclaredMethod("selectedPack");
+            Method replaceStagePacks = state.getClass().getDeclaredMethod("replaceStagePacks", List.class, String.class);
+            selectedPack.setAccessible(true);
+            replaceStagePacks.setAccessible(true);
+            Object selected = selectedPack.invoke(state);
+            String preferredName = selected == null ? "" : (String) selected.getClass().getMethod("getName").invoke(selected);
+            replaceStagePacks.invoke(state, packs, preferredName);
+            return true;
         } catch (Throwable ignored) {
+            return false;
         }
     }
