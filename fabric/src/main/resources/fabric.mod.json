{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {},
  "license": "${mod_license}",
  "icon": "assets/mmdsync/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.opdent.mmdskin.sync.fabric.MMDSyncModFabric"
    ],
    "client": [
      "com.opdent.mmdskin.sync.fabric.MMDSyncModFabricClient"
    ]
  },
  "mixins": [
    {
      "config": "mmdsync-common.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": ">=1.21.1",
    "architectury": ">=${architectury_version}",
    "mmdskin": ">=1.0.0"
  }
}
